<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘 · 하루결" android:textColor="#243044" android:textSize="14sp" />
    <TextView android:id="@+id/widget_habits" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="습관 오늘 요약" android:textColor="#243044" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="오늘 할 일" android:textColor="#243044" android:textSize="16sp" />
    <Button android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="앱 열기" android:contentDescription="잠금 해제 후 하루결 열기" />
</LinearLayout>
